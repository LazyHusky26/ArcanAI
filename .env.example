DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tarot
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_DIM=1024
# Optional: where models download (default: <repo>/models)
# MODEL_DIR=

# Gemini model id, from https://ai.google.dev/gemini-api/docs/models (a Flash model is cheap and fast)
LLM_MODEL=
# Free key from https://aistudio.google.com/apikey (never commit your real .env)
LLM_API_KEY=
